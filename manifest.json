{
  "manifest_version": 3,
  "name": "BJTU 课程助手",
  "description": "聚合智慧课程平台、中国大学MOOC、雨课堂、每日交作业和接龙管家的课程与作业。",
  "version": "11.3.5",
  "default_locale": "zh_CN",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/512.png",
    "48": "icons/512.png",
    "128": "icons/512.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "cookies",
    "webRequest",
    "scripting",
    "downloads",
    "alarms",
    "unlimitedStorage",
    "notifications"
  ],
  "host_permissions": [
    "http://123.121.147.7:88/*",
    "http://123.121.147.7:8081/*",
    "https://www.yuketang.cn/*",
    "https://examination.xuetangx.com/*",
    "https://open.weixin.qq.com/*",
    "https://lulu.lulufind.com/*",
    "https://api-prod.lulufind.com/*",
    "https://zuoye.lulufind.com/*",
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "https://i-api.jielong.com/*",
    "https://www.jielong.com/*",
    "https://i.jielong.com/*",
    "https://www.icourse163.org/*",
    "https://ginnnnnn.top/*",
    "https://v.mbm07.cn/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "action": {
    "default_title": "BJTU 课程助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/512.png",
      "48": "icons/512.png",
      "128": "icons/512.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.icourse163.org/*"
      ],
      "js": [
        "mooc-inject.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://i.jielong.com/*"
      ],
      "js": [
        "jlgj-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://123.121.147.7:88/ve/*"
      ],
      "js": [
        "md5.js",
        "portal-login.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "portal-login.html",
        "MOOC.js"
      ],
      "matches": [
        "http://123.121.147.7:88/*",
        "https://www.icourse163.org/*"
      ]
    }
  ]
}
