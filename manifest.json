{
  "manifest_version": 3,
  "name": "BJTU 课程助手",
  "description": "聚合智慧课程平台、雨课堂、每日交作业、接龙管家、中国大学MOOC和学堂在线的课程与作业，并支持教务系统登录和成绩提醒。",
  "version": "14.0.0",
  "default_locale": "zh_CN",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/128.png",
    "48": "icons/128.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "cookies",
    "webRequest",
    "scripting",
    "downloads",
    "alarms",
    "unlimitedStorage",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "http://123.121.147.7:88/*",
    "http://123.121.147.7:8081/*",
    "https://www.yuketang.cn/*",
    "https://examination.xuetangx.com/*",
    "https://open.weixin.qq.com/*",
    "https://lulu.lulufind.com/*",
    "https://api-prod.lulufind.com/*",
    "https://zuoye.lulufind.com/*",
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "https://i-api.jielong.com/*",
    "https://www.jielong.com/*",
    "https://i.jielong.com/*",
    "https://www.icourse163.org/*",
    "https://www.xuetangx.com/*",
    "https://mp.weixin.qq.com/*",
    "https://aa.bjtu.edu.cn/*",
    "https://bksy.bjtu.edu.cn/*",
    "https://cas.bjtu.edu.cn/*",
    "https://update.greasyfork.org/*",
    "https://login.bjtu.edu.cn:802/*",
    "https://mis.bjtu.edu.cn/*",
    "https://ginnnnnn.top/*",
    "https://cdn.jsdelivr.net/*",
    "https://data.jsdelivr.com/*",
    "https://codeload.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://github.com/*",
    "https://s1y4x1.github.io/*",
    "https://chat.qwen.ai/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_title": "BJTU 课程助手",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/128.png",
      "48": "icons/128.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "app/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "modules/qwen/content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "modules/ve/login-overlay.html",
        "modules/ve/login-overlay.css"
      ],
      "matches": [
        "http://123.121.147.7:88/*"
      ]
    }
  ]
}
